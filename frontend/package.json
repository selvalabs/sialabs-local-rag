{
  "name": "sialabs-local-rag-frontend",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "generate:api": "openapi-typescript ../backend/openapi.json -o src/generated/openapi.ts",
    "test": "vitest run src",
    "build": "tsc -b && vite build",
    "test:e2e": "playwright test",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.0.2",
    "vite": "8.0.16",
    "typescript": "5.9.3",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "openapi-typescript": "7.13.0",
    "@types/react-dom": "19.2.3",
    "@testing-library/react": "16.3.2",
    "jsdom": "30.0.1",
    "vitest": "4.1.11",
    "@playwright/test": "1.62.1"
  }
}
